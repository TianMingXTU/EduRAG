# LLM
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_API_KEY=SILICONFLOW_API_KEY
LLM_BASE_URL=https://api.siliconflow.cn/v1

# Embedding
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_KEY=SILICONFLOW_API_KEY
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# Rerank
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_API_KEY=SILICONFLOW_API_KEY
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=edu_rag

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=0

# Milvus
MILVUS_URI=./milvus_demo.db
MILVUS_COLLECTION=langchain_milvus_demo
MILVUS_COLLECTION_HYBRID=langchain_hy_milvus_demo

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=edurag